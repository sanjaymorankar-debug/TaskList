# Copy to .env and fill in. `npm start`, `npm test` and `npm run import-legacy`
# read .env from this folder if it exists. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# PostgreSQL. On a Mac with Homebrew PostgreSQL, the default below works as is
# (your Mac user, no password). On the VPS later, include user and password:
#   postgres://tasklist:PASSWORD@localhost:5432/tasklist_dev
TASKLIST_DATABASE_URL=postgres://localhost:5432/tasklist_dev

# Used by `npm test` only. The tests EMPTY this database each run, so its name
# must end in _test; anything else is refused.
TASKLIST_TEST_DATABASE_URL=postgres://localhost:5432/tasklist_test

# --- Login ------------------------------------------------------------------
# Both set: TaskList asks for this username and password.
# Either missing: every request is refused, unless TASKLIST_ALLOW_OPEN=1.
TASKLIST_USER=owner
TASKLIST_PASSWORD=change-me
# 1 = no login needed when the two above are unset. Your own machine ONLY.
TASKLIST_ALLOW_OPEN=

# --- Server -----------------------------------------------------------------
TASKLIST_PORT=3100
# 127.0.0.1 keeps it on this machine. Use 0.0.0.0 only behind a firewall/proxy.
TASKLIST_HOST=127.0.0.1

# Running TaskList on its own (not behind the hub)? Point this at a running hub
# (bkesari-platform, `npm start` there) and TaskList fetches the shared top
# menu from it. Behind the hub this is not needed: the hub serves the menu.
TASKLIST_HUB_ORIGIN=

# --- One-off import from the old Task Tracker on MySQL -----------------------
# Only for `npm run import-legacy -- --mysql`. Not needed for --sqlite.
TASKLIST_IMPORT_MYSQL_HOST=localhost
TASKLIST_IMPORT_MYSQL_PORT=3306
TASKLIST_IMPORT_MYSQL_DATABASE=
TASKLIST_IMPORT_MYSQL_USER=
TASKLIST_IMPORT_MYSQL_PASSWORD=
