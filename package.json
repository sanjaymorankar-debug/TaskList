{
  "name": "tasklist",
  "version": "1.0.0",
  "private": true,
  "description": "TaskList: the bkesari.com task list, served at /tasklist/.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/*.test.js'",
    "check": "node --check server.js && for f in src/*.js scripts/*.js public/*.js; do node --check \"$f\" || exit 1; done",
    "import-legacy": "node --env-file-if-exists=.env scripts/import-legacy.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  }
}
